# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Application Settings
DEBUG=false
APP_NAME=Multi-Agent Study Companion
APP_VERSION=1.0.0

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Bedrock Settings
BEDROCK_MODEL_ID=anthropic.claude-v2
BEDROCK_ENDPOINT_URL=

# AWS SageMaker Settings
SAGEMAKER_ENDPOINT_NAME=your-sagemaker-endpoint-name
SAGEMAKER_MODEL_NAME=your-model-name

# DynamoDB Settings
DYNAMODB_TABLE_PREFIX=study_companion_
DYNAMODB_USERS_TABLE=users
DYNAMODB_SESSIONS_TABLE=sessions
DYNAMODB_CONTENT_TABLE=content

# S3 Settings
S3_BUCKET_NAME=study-companion-storage
S3_CONTENT_PREFIX=content/
S3_USER_DATA_PREFIX=user_data/

# Database Settings (Optional - PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/study_companion

# Logging
LOG_LEVEL=INFO

# Frontend Settings (for development)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Multi-Agent Study Companion